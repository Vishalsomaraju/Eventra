# Backend server port
PORT=5000

# Environment mode (development, test, production)
NODE_ENV=development

# Frontend URL allowed for CORS
CORS_ORIGIN=http://localhost:5173

# Neon PostgreSQL connection string (template - replace with your Neon database credentials)
DATABASE_URL=postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Google Gemini API configuration
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=15000

# Optional: Custom Gemini API endpoint or enterprise proxy.
# Leave unset or empty to use the official Google endpoint (https://generativelanguage.googleapis.com)
# GOOGLE_GEMINI_BASE_URL=http://127.0.0.1:8081

